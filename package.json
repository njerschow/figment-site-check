{
  "name": "figment-site-check",
  "version": "0.1.0",
  "description": "Check a static website folder before upload: entry page, sensitive paths, size limits, and unbuilt source files.",
  "main": "index.cjs",
  "types": "index.d.ts",
  "bin": {"figment-site-check": "cli.cjs"},
  "files": ["index.cjs", "index.d.ts", "cli.cjs", "README.md", "LICENSE"],
  "scripts": {"test": "node --test test/*.test.cjs"},
  "engines": {"node": ">=18"},
  "license": "MIT",
  "author": "Figment",
  "homepage": "https://figment.so/",
  "repository": {"type": "git", "url": "https://github.com/njerschow/figment-site-check.git"},
  "bugs": "https://github.com/njerschow/figment-site-check/issues",
  "keywords": ["static-site", "html", "hosting", "preflight", "deployment"],
  "publishConfig": {"access": "public"}
}
